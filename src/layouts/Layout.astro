---
import TransicionPagina from '../components/TransicionPagina.astro';
import { withBase } from '../utils/paths';

// Documento base del lienzo (la portada). Las páginas de contenido usan
// LayoutCarta, que no impone el aspecto del sitio.
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "GASTÓN MARTINO // EN CURSO • Bitácora de Derivas",
  description = "Espacio vivo de producción e investigación. Bitácora de artes electrónicas, prácticas generativas, código creativo, diseño y pensamiento.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full select-none bg-paper-base">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Typography: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="h-full w-full overflow-hidden font-sans text-ink-primary antialiased bg-paper-base">
    {/* La capa de transición va primero, para que cubra la página desde el
        primer cuadro aunque el resto del HTML tarde en llegar. */}
    <TransicionPagina />
    <slot />
  </body>
</html>

<style is:global>
  /* Custom Cursor active on canvas */
  canvas#infinite-canvas {
    cursor: none;
  }

  /* Custom scrollbar reset */
  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: #F5F7FA;
  }
  ::-webkit-scrollbar-thumb {
    background: #D0D6E2;
    border-radius: 2px;
  }
</style>
