---
import Aparejo from '../components/Aparejo.astro';
import Derrotero from '../components/Derrotero.astro';
import EstadoDerrotero from '../components/EstadoDerrotero.astro';
import TransicionPagina from '../components/TransicionPagina.astro';
import CambioVista from '../components/navegacion/CambioVista.astro';
import type { VistasPagina } from '../cartas';
import { withBase } from '../utils/paths';

// Documento base de las cartas (las páginas de contenido). No impone fondo,
// tipografías ni colores: cada carta define los suyos. Aporta lo común a todas
// las páginas: los metadatos, la transición entre páginas, el Aparejo (los
// atajos a otras páginas, que cada carta abre con su BotonAparejo) y el
// Derrotero.
//
// Con vista compartida (desde 1024 px de ancho; ver Derrotero.astro), la página
// ocupa el lugar del Mapa: el resto de la ventana que le deja el Derrotero, al
// otro lado de la costura. La carta se dibuja dentro de .vista-pagina, cuyo
// ancho es el de ese lugar. Sin vista compartida, la página ocupa toda la
// pantalla.
//
// La carta puede agregar elementos al <head> (por ejemplo, sus tipografías)
// con <Fragment slot="head">, y clases a <html> y <body>.
//
// En las páginas con modo lectura (las que reciben `vistas`), agrega además el
// control para cambiar de versión y, en la versión original, lleva al modo
// lectura a quien lo eligió antes para esa página.
interface Props {
  title: string;
  description?: string;
  claseHtml?: string;
  claseCuerpo?: string;
  vistas?: VistasPagina;
}

const { title, description, claseHtml, claseCuerpo, vistas } = Astro.props;
const clavePreferencia = vistas && `cursario:modo-lectura:${vistas.original}`;
const destinoLectura = vistas && withBase(vistas.lectura);
const urlOriginal = vistas && Astro.site ? new URL(withBase(vistas.original), Astro.site).href : undefined;
---

<!doctype html>
<html lang="es" class:list={['contexto-pagina', claseHtml]}>
  <head>
    <meta charset="UTF-8" />
    {vistas?.actual === 'original' && (
      // Antes de dibujar nada; no al volver con "atrás", para no atrapar el historial.
      <script is:inline define:vars={{ clavePreferencia, destinoLectura }}>
        try {
          const navegacion = performance.getEntriesByType('navigation')[0];
          if (localStorage.getItem(clavePreferencia) === 'lectura' && navegacion?.type !== 'back_forward') {
            location.replace(destinoLectura + location.hash);
          }
        } catch {}
      </script>
    )}
    <EstadoDerrotero />
    <!-- Sin bloquear el zoom: en las páginas de contenido se puede ampliar con los dedos. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {vistas?.actual === 'lectura' && urlOriginal && <link rel="canonical" href={urlOriginal} />}
    <!-- Tipografías del sitio, para el Derrotero, el Aparejo y el modo lectura -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={claseCuerpo}>
    {/* La capa de transición va primero, para que cubra la página desde el
        primer cuadro aunque el resto del HTML tarde en llegar. */}
    <TransicionPagina />
    <div class="vista-pagina">
      <slot />
    </div>
    <Derrotero enPagina />
    <Aparejo />
    {vistas && <CambioVista vistas={vistas} />}
  </body>
</html>

<style is:global>
  /* El lugar de la página: el ancho de la ventana menos lo que le quita el
     Derrotero (--derecha-pagina, definida en Derrotero.astro). */
  .vista-pagina {
    width: calc(100% - var(--derecha-pagina, 0px));
    /* Lo que una carta deja sangrar más allá de su lugar se recorta: si no,
       en el celular la página se ensancha y lo fijo a la derecha de la
       ventana queda afuera. clip (y no hidden) no desplaza ni rompe sticky. */
    overflow-x: clip;
  }
</style>
