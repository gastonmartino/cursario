---
import Layout from '../layouts/Layout.astro';
---

<Layout title="GASTÓN MARTINO // ACERCA DE CURSARIO" description="Acerca del proyecto CURSARIO." scrollable={true}>
  <main class="paper-texture min-h-screen px-5 py-16 md:px-8 md:py-24">
    <article class="mx-auto max-w-3xl border border-ink-border/80 bg-white/80 p-6 shadow-sm md:p-12">
      <a href="/" class="font-mono text-xs font-bold text-cobalt hover:text-cobalt-dark">← VOLVER A CURSARIO</a>
      <h1 class="mt-10 font-sans text-3xl font-bold tracking-tight text-ink-primary md:text-5xl">Acerca de Cursario</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">Esta página reúne la presentación general, las decisiones conceptuales y el modo de recorrer el proyecto.</p>
      <p class="mt-4 font-mono text-xs text-ink-faint">Contenido editorial en preparación.</p>
    </article>
  </main>
</Layout>
