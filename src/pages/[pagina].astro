---
// Páginas sueltas del sitio (como "Acerca de"): cada archivo .md de
// public/paginas/ se publica en /{nombre-del-archivo}/. Sus datos (título,
// código, etiqueta, color, descripción) van en el encabezado del archivo, y
// lo arma la carta que elige (ver src/cartas/index.ts).
import { obtenerCarta, type PropsCarta } from '../cartas';
import { rutasPaginasSueltas } from '../cartas/rutas';

export const getStaticPaths = rutasPaginasSueltas;

type Props = PropsCarta;

const Carta = obtenerCarta(Astro.props.documento.datos.carta);
---

<Carta {...Astro.props} />
