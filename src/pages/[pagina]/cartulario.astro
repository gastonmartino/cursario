---
// Versión de modo lectura de las páginas de un solo tramo con carta propia:
// el mismo contenido, armado con el cartulario (ver src/cartas/rutas.ts).
import { obtenerCarta, type PropsCarta } from '../../cartas';
import { esAtajo, rutasDeLectura, rutasDeUnTramo, type RutaCarta } from '../../cartas/rutas';

// Los atajos (alias de los cursos) no son páginas de contenido: no tienen modo lectura.
export const getStaticPaths = () =>
  rutasDeLectura(rutasDeUnTramo().filter((ruta): ruta is RutaCarta<{ pagina: string }> => !esAtajo(ruta)));

type Props = PropsCarta;

const Carta = obtenerCarta();
---

<Carta {...Astro.props} />
