---
// Capa que cubre la página mientras se navega entre páginas del sitio: se
// desvanece al llegar y vuelve a cubrir antes de ir a otro enlace interno.
// Una carta puede cambiar su aspecto redefiniendo #page-transition.
//
// Al llegar se desvanece sola, con una animación CSS: si el JavaScript no
// carga, la página no queda tapada. El script solo la vuelve a mostrar antes
// de salir.
---

<div id="page-transition" class="page-transition-layer" aria-hidden="true"></div>

<script>
  const transitionLayer = document.getElementById('page-transition');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const transitionDuration = prefersReducedMotion ? 0 : 650;

  // Al volver con "atrás", la página puede llegar desde la memoria del
  // navegador tal como quedó al salir, cubierta.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) transitionLayer?.classList.remove('cubriendo');
  });

  document.addEventListener('click', (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey ||
      !(event.target instanceof Element)
    ) return;

    const link = event.target.closest('a[href]') as HTMLAnchorElement | null;
    if (!link || link.target || link.hasAttribute('download')) return;

    const destination = new URL(link.href, window.location.href);
    const current = new URL(window.location.href);
    const isSameDocumentHash =
      destination.pathname === current.pathname &&
      destination.search === current.search &&
      destination.hash;

    if (destination.origin !== current.origin || isSameDocumentHash) return;

    event.preventDefault();
    transitionLayer?.classList.add('cubriendo');

    window.setTimeout(() => {
      window.location.assign(destination.href);
    }, transitionDuration);
  }, true);
</script>

<style is:global>
  .page-transition-layer {
    position: fixed;
    z-index: 100;
    inset: 0;
    /* Con vista compartida, cubre solo el Mapa o la página: el Derrotero
       queda a la vista mientras se navega (ver Derrotero.astro). */
    right: var(--derecha-transicion, 0px);
    pointer-events: none;
    opacity: 0;
    background-color: #F5F7FA;
    background-image:
      radial-gradient(rgba(22, 37, 61, 0.075) 0.55px, transparent 0.7px),
      radial-gradient(rgba(0, 56, 168, 0.04) 0.45px, transparent 0.65px);
    background-position: 0 0, 3px 3px;
    background-size: 7px 7px, 11px 11px;
    animation: revelar-pagina 650ms ease-in-out;
    transition: opacity 650ms ease-in-out;
  }

  .page-transition-layer.cubriendo {
    opacity: 1;
    animation: none;
  }

  @keyframes revelar-pagina {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition-layer {
      animation: none;
      transition-duration: 0ms;
    }
  }
</style>
