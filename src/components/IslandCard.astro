---
import fs from 'node:fs';
import path from 'node:path';
import { renderMarkdownToHtml } from '../utils/markdown';

interface Props {
  id: string;
  code: string;
  title?: string | null;
  subtitle?: string | null;
  description?: string | null;
  keywords?: string | null;
  tag: string;
  timeReference?: string | null;
  accentColor?: string;
  imageUrl?: string;
  imageLoading?: 'eager' | 'lazy';
  derivaId: string;
  coordinatesText: string;
  categoryLabel?: string | null;
  captionLabel?: string;
  width?: number | string;
  height?: number | string;
  imageMaxHeight?: number | string;
  backgroundColor?: string;
  headerTypeLabel?: string;
  zIndex?: number;
  borderWidth?: number | string;
  borderColor?: string;
  paddingY?: number | string;
  paddingX?: number | string;

// Detalle / Navegación siguiente nivel
  markdownHtml?: string;
  markdownFile?: string | null;
  pageMarkdownFile?: string | null;
  actionHref?: string | null;
  detailHref?: string | null;
  isSubderiva?: boolean;
  actionLabel?: string;
  showAction?: boolean;
}

const {
  id,
  code,
  title,
  subtitle,
  description,
  keywords,
  tag,
  timeReference,
  accentColor = "#0038A8",
  imageUrl,
  imageLoading = 'eager',
  derivaId,
  coordinatesText,
  categoryLabel,
  captionLabel = "EXPLORACIÓN VIVA",
  width = 740,
  height = 730,
  imageMaxHeight = 380,
  backgroundColor = "#FAFAFA",
  headerTypeLabel = "// ISLA DE CONTENIDO",
  zIndex = 20,
  borderWidth = 2,
  borderColor,
  paddingY = "0.9rem",
  paddingX = "1.2rem",
  actionLabel = "INCURSIONAR [CLICK / ENTER]",

// Markdown HTML y Markdown File definen contenido dinámico para la deriva,
// es decir, lo que se muestra dentro de la propia tarjeta.
  markdownHtml,
  markdownFile = null,

// Page Markdown File, es el archivo .md (opcional) al que se debe navegar
// desde la subderiva (no existe para las derivas de primer nivel)
  pageMarkdownFile = null,
  actionHref,
  detailHref,
  isSubderiva = false,

// El atributo "showAction" permite definir si se muestra o no se muestra
// el botón para navegar al siguiente nivel (INCURSIONAR). En las subderivas,
// el botón también requiere que exista un pageMarkdownFile.
  showAction = true,

} = Astro.props;


const widthCss = typeof width === 'number' ? `${width}px` : width;
const heightCss = typeof height === 'number' ? `${height}px` : height;
const imageMaxHeightCss = typeof imageMaxHeight === 'number' ? `${imageMaxHeight}px` : imageMaxHeight;
const borderWidthCss = typeof borderWidth === 'number' ? `${borderWidth}px` : borderWidth;
const paddingYCss = typeof paddingY === 'number' ? `${paddingY}rem` : paddingY;
const paddingXCss = typeof paddingX === 'number' ? `${paddingX}rem` : paddingX;
const finalBorderColor = borderColor || accentColor;
const hasImage = Boolean(imageUrl);
const hasTitle = Boolean(title);
const hasSubtitle = Boolean(subtitle);
const hasDescription = Boolean(description);
const keywordChips = keywords
  ? keywords.split(',').map((keyword) => keyword.trim()).filter(Boolean)
  : [];
let resolvedMarkdownHtml = markdownHtml || '';

if (!resolvedMarkdownHtml && markdownFile) {
  try {
    const markdownPath = path.join(process.cwd(), 'public', markdownFile.replace(/^\/+/, ''));
    resolvedMarkdownHtml = renderMarkdownToHtml(fs.readFileSync(markdownPath, 'utf-8'));
  } catch (error) {
    console.error(`Error al leer el Markdown ${markdownFile}:`, error);
  }
}

const hasMarkdown = Boolean(resolvedMarkdownHtml);
const hasMediaMetadata = !isSubderiva || Boolean(categoryLabel || timeReference);
// A custom detailHref can be used for a second-level card with an explicit
// destination. Otherwise, subderivas only become clickable when their
// editorial page exists.
const navigableHref = detailHref || (isSubderiva && pageMarkdownFile ? actionHref : undefined);
// Subderiva cards use actionHref to open their detail page. That action is
// only available when the corresponding editorial page exists.
const canShowAction = isSubderiva
  ? showAction && Boolean(pageMarkdownFile)
  : showAction;
---

<article 
  id={id}
  data-detail-href={navigableHref}
  class="absolute top-0 left-0 shadow-xl rounded-sm flex flex-col justify-between select-none pointer-events-auto transition-opacity duration-200"
  style={`
    width: ${widthCss}; 
    min-height: ${heightCss}; 
    background-color: ${backgroundColor}; 
    border-style: solid;
    border-width: ${borderWidthCss}; 
    border-color: ${finalBorderColor}; 
    padding-top: ${paddingYCss}; 
    padding-bottom: ${paddingYCss}; 
    padding-left: ${paddingXCss}; 
    padding-right: ${paddingXCss}; 
    transform-origin: center center; 
    opacity: 1; 
    z-index: ${zIndex};
  `}
>
  <!-- Technical Header Bar -->
  <div>
    <div class="flex items-center justify-between border-b border-ink-border/50 pb-3 mb-4">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full animate-pulse" style={`background-color: ${accentColor};`}></span>
        <span class="font-mono text-xs font-bold uppercase tracking-wider" style={`color: ${accentColor};`}>{code}</span>
        <span class="text-xs text-ink-faint font-mono">{headerTypeLabel}</span>
      </div>
      <span 
        class="font-mono text-[10px] px-2 py-1 rounded font-semibold tracking-widest border uppercase"
        style={`color: ${accentColor}; border-color: ${accentColor}33; background-color: ${accentColor}12;`}
      >
        {tag}
      </span>
    </div>

    <!-- Titles Section -->
    {(hasTitle || hasSubtitle) && (
    <div class="mb-4">
      {hasTitle && (
      <h2 class="font-sans font-bold text-2xl text-ink-primary tracking-tight">
        {title}
      </h2>
      )}
      {hasSubtitle && (
      <p class="font-sans text-sm font-semibold mt-0.5" style={`color: ${accentColor};`}>
        {subtitle}
      </p>
      )}
    </div>
    )}

    {hasDescription && (
    <div class="mb-4 w-full">
      <p class="font-sans text-sm leading-relaxed text-ink-muted">
        {description}
      </p>
    </div>
    )}

    {isSubderiva && keywordChips.length > 0 && (
    <div class="mb-4 flex w-full flex-wrap gap-2">
      {keywordChips.map((keyword) => (
        <span class="rounded-sm border border-cobalt/25 bg-cobalt/5 px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wide text-cobalt">
          {keyword}
        </span>
      ))}
    </div>
    )}

    <div class="w-full h-px bg-ink-border/40 my-3"></div>

    <!-- Flexible Body: Image and/or Markdown -->
    <div class:list={[
      'grid grid-cols-1 gap-5 items-start my-2',
      hasImage && hasMarkdown && 'md:grid-cols-12',
    ]}>
      <!-- Image column / full-width image -->
      {hasImage && (
      <div class:list={[
        'flex flex-col gap-2',
        hasMarkdown ? 'md:col-span-5' : 'w-full',
      ]}>
        <div 
          class:list={[
            'relative group overflow-hidden flex items-center justify-center',
            hasMarkdown
              ? 'rounded-sm border p-2 shadow-sm min-h-[320px]'
              : 'w-full min-h-[240px]',
        ]}
          style={hasMarkdown
            ? `border-color: ${accentColor}40; background-color: rgba(224, 228, 235, 0.3);`
            : undefined}
        >
          <div
            data-image-placeholder
            class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center bg-paper-sheet/70"
            aria-hidden="true"
          >
            <svg
              class="h-8 w-8 animate-spin text-cobalt/60"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle class="opacity-20" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
              <path class="opacity-80" d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </div>
          <img 
            data-island-image
            src={imageUrl} 
            alt={title} 
            class:list={[
              'relative z-10 h-auto object-contain rounded-xs opacity-0 transition-[opacity,transform] duration-500 group-hover:scale-105',
              hasMarkdown ? 'w-auto max-w-full' : 'w-full max-w-full',
            ]}
            style={`max-height: ${hasMarkdown ? imageMaxHeightCss : 'none'};`}
            loading={imageLoading}
            decoding="async"
          />
          {hasMarkdown && (
          <div class="absolute inset-0 pointer-events-none" style={`background-color: ${accentColor}08;`}></div>
          )}
        </div>
        {hasMediaMetadata && (
        <div class="flex items-center justify-between font-mono text-[9px] text-ink-faint px-1">
          <span>{categoryLabel}</span>
          <span>{timeReference}</span>
        </div>
        )}
      </div>
      )}

      <!-- Markdown column / full-width content -->
      {hasMarkdown && (
      <div class:list={[
        'flex flex-col justify-between h-full bg-white/70 p-4 border border-ink-border/30 rounded-sm',
        hasImage ? 'md:col-span-7' : 'w-full',
      ]}>
        <div class="prose prose-sm font-sans text-ink-primary text-xs leading-relaxed space-y-2">
          <Fragment set:html={resolvedMarkdownHtml} />
        </div>
      </div>
      )}
    </div>
  </div>

  <!-- Footer Action Button -->
  <div class="mt-4 pt-3 border-t border-ink-border/40 flex items-center justify-between">
    <div class="font-mono text-[10px] text-ink-muted flex items-center gap-2">
      <span style={`color: ${accentColor};`}>✦</span> COORDENADAS: {coordinatesText}
    </div>
    {canShowAction && actionHref && (
      <a
        href={actionHref}
        class="px-4 py-2 text-white transition-all font-mono text-xs font-bold rounded-sm shadow-xs flex items-center gap-2 cursor-pointer border hover:scale-102"
        style={`background-color: ${accentColor}; border-color: ${accentColor};`}
      >
        {actionLabel}
      </a>
    )}
    {!isSubderiva && canShowAction && !actionHref && (
      <button
        data-incursionar={derivaId}
        data-fly-to={derivaId}
        class="px-4 py-2 text-white transition-all font-mono text-xs font-bold rounded-sm shadow-xs flex items-center gap-2 cursor-pointer border hover:scale-102"
        style={`background-color: ${accentColor}; border-color: ${accentColor};`}
      >
        {actionLabel}
      </button>
    )}
  </div>
</article>
