---
import fs from 'node:fs';
import path from 'node:path';
import { renderMarkdownToHtml } from '../utils/markdown';
import { withBase } from '../utils/paths';

interface Props {
  id: string;
  code: string;
  title?: string | null;
  subtitle?: string | null;
  description?: string | null;
  keywords?: string | null;
  tag: string;
  imageDate?: string | null;
  accentColor?: string;
  imageUrl?: string | null;
  markdownFile?: string | null;
  actionHref?: string | null;
  actionLabel?: string;
  showAction?: boolean;
  imageCaption?: string | null;
  headerLabel?: string;
  showHeader?: boolean;
  width?: number | string;
  height?: number | string;
  imageMaxHeight?: number | string;
  backgroundColor?: string | null;
  imageLoading?: 'eager' | 'lazy';
}

const {
  id,
  code,
  title,
  subtitle,
  description,
  keywords,
  tag,
  imageDate,
  accentColor = '#0038A8',
  imageUrl,
  markdownFile = null,
  actionHref,
  actionLabel = 'INCURSIONAR [ABRIR]',
  showAction = true,
  imageCaption,
  headerLabel = 'ISLOTE',
  showHeader = true,
  width = 420,
  height = 320,
  imageMaxHeight = 200,
  backgroundColor = null,
  imageLoading = 'lazy',
} = Astro.props;

const widthCss = typeof width === 'number' ? `${width}px` : width;
const heightCss = typeof height === 'number' ? `${height}px` : height;
const imageMaxHeightCss = typeof imageMaxHeight === 'number' ? `${imageMaxHeight}px` : imageMaxHeight;
const hasImage = Boolean(imageUrl);
const hasTitle = Boolean(title);
const hasSubtitle = Boolean(subtitle);
const descriptionHtml = description ? renderMarkdownToHtml(description) : '';
const hasDescription = Boolean(descriptionHtml);
const keywordsList = keywords?.split(',').map((keyword) => keyword.trim()).filter(Boolean) ?? [];
let markdownHtml = '';

if (markdownFile) {
  try {
    const markdownPath = path.join(process.cwd(), 'public', markdownFile.replace(/^\/+/, ''));
    markdownHtml = renderMarkdownToHtml(fs.readFileSync(markdownPath, 'utf-8'));
  } catch (error) {
    console.error(`Error al leer el Markdown del islote ${markdownFile}:`, error);
  }
}

const hasMarkdown = Boolean(markdownHtml);
// El pie de la imagen (texto a la izquierda, fecha a la derecha): solo con imagen.
const hasImageMetadata = Boolean(hasImage && (imageCaption || imageDate));
---

{/* El islote empieza oculto (display: none) hasta que el motor lo ubique:
    así sus imágenes, que son lazy, no se descargan si no pertenece al lienzo
    que se está viendo. */}
<article
  id={id}
  class="absolute left-0 top-0 flex select-none flex-col justify-between overflow-hidden rounded-lg border border-dotted border-ink-border/70 bg-transparent p-3 shadow-md pointer-events-auto"
  style={`display: none; width: ${widthCss}; min-height: ${heightCss}; border-color: ${accentColor}99;${backgroundColor ? ` background-color: ${backgroundColor};` : ''}`}
>
  <div>
    {showHeader && (
      <div class="mb-2 flex items-center justify-between gap-2 border-b border-ink-border/40 pb-2">
        <div class="flex min-w-0 items-center gap-1.5">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background-color: ${accentColor};`}></span>
          <span class="font-mono text-[10px] font-bold tracking-wider" style={`color: ${accentColor};`}>{code}</span>
        </div>
        <span class="shrink-0 font-mono text-[9px] tracking-wider text-ink-faint">{tag}</span>
      </div>
    )}

    {(hasTitle || hasSubtitle) && (
      <div class="mb-2">
        {hasTitle && <h2 class="font-sans text-[17px]/6 font-bold leading-tight text-ink-primary">{title}</h2>}
        {hasSubtitle && <p class="mt-0.5 font-sans text-[11px] font-semibold leading-tight" style={`color: ${accentColor};`}>{subtitle}</p>}
      </div>
    )}

    {hasDescription && <div class="mb-2 min-w-0"><Fragment set:html={descriptionHtml} /></div>}

    {keywordsList.length > 0 && (
      <div class="mb-2 flex flex-wrap gap-1">
        {keywordsList.map((keyword) => <span class="rounded-sm border border-cobalt/20 bg-cobalt/5 px-1.5 py-0.5 font-mono text-[9px] text-cobalt">{keyword}</span>)}
      </div>
    )}

    {(hasImage || hasMarkdown) && (
      <div class="grid grid-cols-1 gap-2">
        {hasImage && (
          <figure class="m-0">
            <img src={withBase(imageUrl)} alt={title || headerLabel} class="h-auto w-full rounded-sm object-contain" style={`max-height: ${imageMaxHeightCss};`} loading={imageLoading} decoding="async" draggable="false" />
            {hasImageMetadata && <figcaption class="mt-1 flex items-center justify-between font-mono text-[9px] text-ink-faint"><span>{imageCaption}</span><span>{imageDate}</span></figcaption>}
          </figure>
        )}
        {hasMarkdown && <div class="min-w-0 text-[11px] leading-relaxed text-ink-primary"><Fragment set:html={markdownHtml} /></div>}
      </div>
    )}
  </div>

  {showAction && actionHref && (
    <div class="mt-3 border-t border-ink-border/40 pt-2">
      <a
        href={withBase(actionHref)}
        class="inline-flex rounded-sm border px-3 py-1.5 font-mono text-[11px] font-bold text-white shadow-sm transition-all hover:scale-[1.02]"
        style={`background-color: ${accentColor}; border-color: ${accentColor};`}
      >
        {actionLabel}
      </a>
    </div>
  )}
</article>
