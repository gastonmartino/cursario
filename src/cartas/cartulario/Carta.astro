---
// CARTULARIO
// La carta estándar: el aspecto del sitio Cursario (papel, paleta, Geist), con
// una barra superior de navegación y el contenido en una hoja blanca centrada.
import LayoutCarta from '../../layouts/LayoutCarta.astro';
import Volver from '../../components/navegacion/Volver.astro';
import BotonMenu from '../../components/navegacion/BotonMenu.astro';
import { renderizarBloques } from '../../utils/markdown';
import { withBase } from '../../utils/paths';
import type { PropsCarta } from '../index';
import { CLASES_CARTULARIO } from './clases';

type Props = PropsCarta;

const { pagina, documento, volver } = Astro.props;
const contenidoHtml = renderizarBloques(documento.bloques, CLASES_CARTULARIO);
---

<LayoutCarta
  title={`GASTÓN MARTINO // ${pagina.codigo} • ${pagina.titulo}`}
  description={documento.datos.descripcion ?? `${pagina.subtitulo}. Bitácora de Derivas de Gastón Martino.`}
  claseHtml="min-h-full bg-paper-base"
  claseCuerpo="min-h-full w-full overflow-x-hidden font-sans text-ink-primary antialiased bg-paper-base"
>
  <Fragment slot="head">
    <!-- Typography: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </Fragment>

  <div class="paper-texture min-h-screen">
    <header class="sticky top-0 z-30 border-b border-ink-border/70 bg-paper-base/90 px-4 py-3 backdrop-blur-md md:px-6 md:py-4">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
        <nav class="order-1 flex items-center overflow-hidden rounded-sm border border-ink-border/70 bg-white/85 shadow-sm" aria-label="Navegación de la deriva">
          <Volver
            href={volver}
            class="border-r border-ink-border/60 px-3 py-2 font-mono text-xs font-bold transition-colors hover:bg-river-mist md:px-4"
            style={`color: ${pagina.color};`}
          />
          <a
            href={withBase('/')}
            class="px-3 py-2 font-mono text-xs font-bold text-ink-primary transition-colors hover:bg-paper-sheet hover:text-cobalt md:px-4"
          >
            INICIO
          </a>
        </nav>

        <div class="order-3 w-full flex items-center gap-2 rounded-sm border border-ink-border/70 bg-white/85 px-3.5 py-2 shadow-sm font-mono text-xs text-ink-primary md:order-2 md:w-auto md:px-4">
          <span class="h-2 w-2 rounded-full animate-pulse" style={`background-color: ${pagina.color};`}></span>
          <span class="text-ink-faint">DERIVA:</span>
          <span class="font-bold" style={`color: ${pagina.color};`}>[{pagina.codigo}] {pagina.titulo.toUpperCase()}</span>
        </div>

        <BotonMenu class="order-2 flex h-9 w-9 items-center justify-center rounded-sm border border-ink-border/70 bg-white/85 text-ink-primary shadow-sm transition-colors hover:bg-paper-sheet hover:text-cobalt md:order-3" />
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-5 py-7 md:px-8 md:py-10">
      <article class="border border-ink-border/80 bg-white/80 p-6 shadow-sm md:p-12">
        <div class="mb-10 border-b border-ink-border/60 pb-6">
          <div class="mb-4 flex items-center gap-2 font-mono text-[11px] font-bold tracking-widest" style={`color: ${pagina.color};`}>
            <span class="h-2 w-2 rounded-full" style={`background-color: ${pagina.color};`}></span>
            {pagina.codigo} // {pagina.etiqueta}
          </div>
          <p class="font-sans text-lg font-semibold" style={`color: ${pagina.color};`}>{pagina.subtitulo}</p>
        </div>

        <div class="markdown-page-content">
          <Fragment set:html={contenidoHtml} />
        </div>
      </article>
    </main>
  </div>
</LayoutCarta>

<style>
  .paper-texture {
    background-color: #F5F7FA;
    background-image:
      radial-gradient(rgba(22, 37, 61, 0.075) 0.55px, transparent 0.7px),
      radial-gradient(rgba(0, 56, 168, 0.04) 0.45px, transparent 0.65px);
    background-position: 0 0, 3px 3px;
    background-size: 7px 7px, 11px 11px;
  }
</style>

<style is:global>
  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: #F5F7FA;
  }
  ::-webkit-scrollbar-thumb {
    background: #D0D6E2;
    border-radius: 2px;
  }
</style>
