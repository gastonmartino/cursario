---
// CARTULARIO
// La carta estándar: el aspecto del sitio Cursario (papel, paleta, Geist), con
// una barra superior de navegación y el contenido en una hoja blanca centrada.
import LayoutCarta from '../../layouts/LayoutCarta.astro';
import Volver from '../../components/navegacion/Volver.astro';
import BotonAparejo from '../../components/navegacion/BotonAparejo.astro';
import { renderizarBloques } from '../../utils/markdown';
import type { PropsCarta } from '../index';
import { CLASES_CARTULARIO } from './clases';

type Props = PropsCarta;

const { pagina, documento, volver, vistas } = Astro.props;
const contenidoHtml = renderizarBloques(documento.bloques, CLASES_CARTULARIO);
---

<LayoutCarta
  vistas={vistas}
  title={`GASTÓN MARTINO // ${pagina.codigo} • ${pagina.titulo}`}
  description={documento.datos.descripcion ?? `${pagina.subtitulo}. Bitácora de Derivas de Gastón Martino.`}
  claseHtml="html-cartulario min-h-full bg-white md:bg-paper-base"
  claseCuerpo="min-h-full w-full overflow-x-hidden font-sans text-ink-primary antialiased bg-white md:bg-paper-base"
>
  <Fragment slot="head">
    <!-- Typography: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </Fragment>

  <div class="paper-texture min-h-screen">
    <!-- Encabezado en una sola fila: en pantallas chicas no se muestra la caja
         de la deriva (el título ya está en el contenido); en las demás, un
         nombre que no entra se corta. -->
    <header class="sticky top-0 z-30 border-b border-ink-border/70 bg-white/90 px-4 py-3 backdrop-blur-md md:bg-paper-base/90 md:px-6 md:py-4">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3">
        <nav class="flex shrink-0 items-center overflow-hidden rounded-sm border border-ink-border/70 bg-white/85 shadow-sm" aria-label="Navegación de la deriva">
          <Volver
            href={volver}
            class="px-3 py-2 font-mono text-xs font-bold transition-colors hover:bg-river-mist md:px-4"
            style={`color: ${pagina.color};`}
          />
        </nav>

        <div class="hidden min-w-0 items-center gap-2 rounded-sm border border-ink-border/70 bg-white/85 px-4 py-2 shadow-sm font-mono text-xs text-ink-primary md:flex">
          <span class="h-2 w-2 shrink-0 rounded-full animate-pulse" style={`background-color: ${pagina.color};`}></span>
          <span class="shrink-0 text-ink-faint">DERIVA:</span>
          <span class="truncate font-bold" style={`color: ${pagina.color};`}>[{pagina.codigo}] {pagina.titulo.toUpperCase()}</span>
        </div>

        <BotonAparejo class="flex h-9 w-9 shrink-0 items-center justify-center rounded-sm border border-ink-border/70 bg-white/85 text-ink-primary shadow-sm transition-colors hover:bg-paper-sheet hover:text-cobalt" />
      </div>
    </header>

    <!-- En pantallas chicas, el contenido va directo sobre el fondo blanco, sin
         el marco de la hoja. -->
    <main class="mx-auto max-w-4xl px-5 py-7 md:px-8 md:py-10">
      <article class="md:border md:border-ink-border/80 md:bg-white/80 md:p-12 md:shadow-sm">
        <div class="mb-10 border-b border-ink-border/60 pb-6">
          <div class="mb-4 flex items-center gap-2 font-mono text-[11px] font-bold tracking-widest" style={`color: ${pagina.color};`}>
            <span class="h-2 w-2 rounded-full" style={`background-color: ${pagina.color};`}></span>
            {pagina.codigo} // {pagina.etiqueta}
          </div>
          <p class="font-sans text-lg font-semibold" style={`color: ${pagina.color};`}>{pagina.subtitulo}</p>
        </div>

        <div class="markdown-page-content">
          <Fragment set:html={contenidoHtml} />
        </div>
      </article>
    </main>
  </div>
</LayoutCarta>

<style>
  /* Textura de papel en pantallas medianas y grandes; en las chicas, fondo blanco. */
  @media (min-width: 768px) {
    .paper-texture {
      background-color: #F5F7FA;
      background-image:
        radial-gradient(rgba(22, 37, 61, 0.075) 0.55px, transparent 0.7px),
        radial-gradient(rgba(0, 56, 168, 0.04) 0.45px, transparent 0.65px);
      background-position: 0 0, 3px 3px;
      background-size: 7px 7px, 11px 11px;
    }
  }
</style>

<style is:global>
  /* Los estilos globales del bundle llegan a todas las páginas de cartas: cada
     regla va bajo la clase de la carta en <html>. */
  html.html-cartulario ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  html.html-cartulario ::-webkit-scrollbar-track {
    background: #F5F7FA;
  }
  html.html-cartulario ::-webkit-scrollbar-thumb {
    background: #D0D6E2;
    border-radius: 2px;
  }
</style>
