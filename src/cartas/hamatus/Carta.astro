---
// HAMATUS
// Carta experimental para la página de Homo Hamatus: un expediente de
// excavación abierto en el escritorio de un sistema operativo de fines de los
// noventa. Mezcla la investigación antropológica de una hominización
// especulativa con ventanas, íconos y barras de un sistema falso, y con mapas
// de Latinoamérica como sitios de hallazgo. Solo para escritorio, por ahora.
//
// El contenido sale de la estructura del Markdown, sin opciones propias:
//   - "#" es el título de la portada, y un "##" inmediatamente después, su
//     bajada (en minúsculas);
//   - hasta el primer "##" siguiente va el prólogo: la primera imagen es la
//     ventana de la portada; una cita que es solo un enlace, un ícono del
//     escritorio; un "###" con sus párrafos, una ficha; una cita "**X**: a,
//     b, c", una lista de palabras clave;
//   - cada "##" es un capítulo: un estrato de la excavación;
//   - una foto es una imagen .webp con una versión tramada al lado, con el
//     mismo nombre y "-trama.png": se muestra la trama y, al pasar el cursor,
//     el color. Las fotos seguidas se agrupan en una carpeta; una foto sola o
//     una lámina (cualquier otra imagen) van en su propia ventana;
//   - las frases cortas entre comillas (“…”) de cada capítulo flotan en sus
//     márgenes, en minúsculas;
//   - los párrafos de referencias ("**Autor** (año). Título…") van como
//     archivos de una carpeta.
//
// El diseño se compone sobre una lámina de 1280 px de ancho, que se escala
// para ocupar el lugar de la página (ver el script). Los estilos van todos
// bajo html.html-hamatus (hamatus.css).
import fs from 'node:fs';
import path from 'node:path';
import LayoutCarta from '../../layouts/LayoutCarta.astro';
import Volver from '../../components/navegacion/Volver.astro';
import BotonAparejo from '../../components/navegacion/BotonAparejo.astro';
import BotonMenuDerrotero from '../../components/navegacion/BotonMenuDerrotero.astro';
import Ventana from './Ventana.astro';
import Foto from './Foto.astro';
import Pieza from './Pieza.astro';
import { renderizarEnLinea, type BloqueMimo } from '../../utils/markdown';
import { withBase } from '../../utils/paths';
import type { PropsCarta } from '../index';
import mapaLatinoamerica from './mapas/mapa-latinoamerica.svg?url';
import mapaLatinoamericaAncha from './mapas/mapa-latinoamerica-ancha.svg?url';
import mapaConoSur from './mapas/mapa-cono-sur.svg?url';
import mapaAndes from './mapas/mapa-andes.svg?url';
import mapaRioDeLaPlata from './mapas/mapa-rio-de-la-plata.svg?url';
import fondoLowTech from './fondos/low-tech.jpg?url';
import fondoTrabajoFeminizado from './fondos/trabajo-feminizado.jpg?url';
import './hamatus.css';

type Props = PropsCarta;
const { pagina, documento, volver, vistas, mapa } = Astro.props;

type Imagen = Extract<BloqueMimo, { tipo: 'imagen' }>;
type Cita = Extract<BloqueMimo, { tipo: 'cita' }>;

// --- Lectura del Markdown ---------------------------------------------------
const bloques = documento.bloques;
const iH1 = bloques.findIndex((b) => b.tipo === 'titulo' && b.nivel === 1);
const h1 = iH1 >= 0 ? (bloques[iH1] as Extract<BloqueMimo, { tipo: 'titulo' }>) : null;
const siguiente = bloques[iH1 + 1];
const bajada = siguiente?.tipo === 'titulo' && siguiente.nivel === 2 ? siguiente.texto : '';
const inicioPrologo = iH1 + 1 + (bajada ? 1 : 0);
const iPrimerCapitulo = bloques.findIndex((b, i) => i >= inicioPrologo && b.tipo === 'titulo' && b.nivel === 2);
const prologo = bloques.slice(inicioPrologo, iPrimerCapitulo < 0 ? undefined : iPrimerCapitulo);

interface Capitulo { titulo: string; bloques: BloqueMimo[] }
const capitulos: Capitulo[] = [];
for (const b of iPrimerCapitulo < 0 ? [] : bloques.slice(iPrimerCapitulo)) {
  if (b.tipo === 'titulo' && b.nivel === 2) capitulos.push({ titulo: b.texto, bloques: [] });
  else capitulos[capitulos.length - 1]?.bloques.push(b);
}

const textoCita = (cita: Cita) => cita.partes.map((p) => (p.tipo === 'texto' ? p.texto : '')).join(' ').trim();
const enlaceSolo = (texto: string) => texto.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
const sinMarcas = (texto: string) => texto.replace(/\*+|_/g, '').trim();
import { esVertical, nombreArchivo, originalDe, tramaDe } from './archivos';

// Láminas que en esta página van integradas al fondo de su capítulo, en lugar
// de en una ventana: contienen ventanas, y adentro de otra se ven extrañas. En
// el modo lectura siguen como imágenes. (La carta es propia de esta página.)
const LAMINAS_DE_FONDO: Record<string, string[]> = {
  '/curso01/subcursos/curso003/medios/homo-hamatus-005.jpg': [fondoLowTech, fondoTrabajoFeminizado],
};

// Frases cortas entre comillas: los susurros de cada capítulo.
const susurrosDe = (textos: string[]) => [...new Set(textos.flatMap((t) =>
  [...t.matchAll(/“([^”]{3,28})”/g)].map((m) => sinMarcas(m[1]).toLowerCase())))];

const referencia = (texto: string) => texto.match(/^\*\*(.+?)\*\*\s*\((\d{4})\)\.?\s*(.*)$/);

// Agrupa las imágenes seguidas.
type TipoPieza =
  | { tipo: 'imagenes'; imagenes: Imagen[] }
  | { tipo: 'video'; youtube: string }
  | { tipo: 'cita'; texto: string };
const piezasDe = (lista: BloqueMimo[]) => {
  const piezas: TipoPieza[] = [];
  for (const b of lista) {
    const ultima = piezas[piezas.length - 1];
    if (b.tipo === 'imagen') {
      // Solo las fotos seguidas se agrupan; una lámina va siempre sola.
      if (LAMINAS_DE_FONDO[b.src]) continue;
      const esFoto = Boolean(tramaDe(b.src));
      if (esFoto && ultima?.tipo === 'imagenes' && ultima.imagenes.every((i) => tramaDe(i.src))) ultima.imagenes.push(b);
      else piezas.push({ tipo: 'imagenes', imagenes: [b] });
    } else if (b.tipo === 'video') {
      piezas.push({ tipo: 'video', youtube: b.youtube });
    } else if (b.tipo === 'cita') {
      piezas.push({ tipo: 'cita', texto: textoCita(b) });
    }
  }
  return piezas;
};

// Prólogo: portada, íconos, ficha, palabras clave y láminas sueltas.
const imagenesPrologo = prologo.filter((b): b is Imagen => b.tipo === 'imagen');
const fotoPortada = imagenesPrologo[0];
const laminasPrologo = imagenesPrologo.slice(1);
const iconos = prologo
  .filter((b): b is Cita => b.tipo === 'cita')
  .map((c) => enlaceSolo(textoCita(c)))
  .filter(Boolean)
  .map((m) => ({ texto: m![1], href: m![2] }));
const palabrasClave = prologo
  .filter((b): b is Cita => b.tipo === 'cita')
  .map((c) => textoCita(c).match(/^\*\*(.+?)\*\*\s*:\s*(.+)$/))
  .filter(Boolean)
  .map((m) => ({ rotulo: m![1], items: m![2].split(',').map((s) => s.trim()).filter(Boolean) }))[0];
const iFicha = prologo.findIndex((b) => b.tipo === 'titulo' && b.nivel === 3);
const ficha = iFicha >= 0 ? {
  titulo: sinMarcas((prologo[iFicha] as Extract<BloqueMimo, { tipo: 'titulo' }>).texto),
  textos: prologo.slice(iFicha + 1).filter((b) => b.tipo === 'parrafo').map((b) => (b as Extract<BloqueMimo, { tipo: 'parrafo' }>).texto),
} : null;

// --- Presentación -----------------------------------------------------------
const CLASES_TEXTO = { negrita: 'hm-seleccion', italica: 'hm-italica', enlace: 'hm-enlace', codigo: 'hm-codigo' };
const enLinea = (texto: string) => renderizarEnLinea(texto, CLASES_TEXTO);
const ROMANOS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const MAPAS = [mapaConoSur, mapaRioDeLaPlata, mapaAndes, mapaLatinoamerica];
const profundidad = (i: number) => `−${((i + 1) * 1.35).toFixed(2).replace('.', ',')} m`;
const palabrasTitulo = (h1?.texto ?? pagina.titulo).split(/\s+/);


const secciones = capitulos.map((cap, i) => {
  const parrafos = cap.bloques.filter((b) => b.tipo === 'parrafo').map((b) => (b as Extract<BloqueMimo, { tipo: 'parrafo' }>).texto);
  const refs = parrafos.map(referencia);
  const esReferencias = parrafos.length > 0 && refs.every(Boolean);
  return {
    id: `estrato-${i + 1}`,
    numero: ROMANOS[i] ?? String(i + 1),
    titulo: sinMarcas(cap.titulo),
    parrafos,
    piezas: piezasDe(cap.bloques),
    susurros: susurrosDe(parrafos),
    referencias: esReferencias ? refs.map((m) => ({ autor: m![1], anio: m![2], titulo: m![3] })) : null,
    flujo: [] as EntradaFlujo[],
    fondos: cap.bloques.flatMap((b) => (b.tipo === 'imagen' && LAMINAS_DE_FONDO[b.src]) || []),
    mapa: MAPAS[i % MAPAS.length],
    espejo: i % 2 === 1,
  };
});

const capitulosConTexto = secciones.filter((s) => !s.referencias);

// Composición media: los párrafos de un capítulo con sus piezas intercaladas.
// Las piezas se reparten entre los párrafos (antes del primero, del medio…),
// y los susurros (hasta tres) van como notas al margen entre ellas.
type EntradaFlujo =
  | { tipo: 'parrafo'; texto: string }
  | { tipo: 'susurro'; texto: string }
  | { tipo: 'pieza'; pieza: TipoPieza; indice: number };
const flujoDe = (parrafos: string[], piezas: TipoPieza[], susurros: string[]): EntradaFlujo[] => {
  const despues = new Map<number, EntradaFlujo[]>();
  const agregar = (lugar: number, entrada: EntradaFlujo) => despues.set(lugar, [...(despues.get(lugar) ?? []), entrada]);
  piezas.forEach((pieza, j) => {
    const lugar = Math.min(parrafos.length - 1, Math.floor((j * parrafos.length) / Math.max(1, piezas.length)));
    agregar(lugar, { tipo: 'pieza', pieza, indice: j });
  });
  susurros.slice(0, 3).forEach((texto, k) => agregar(Math.min(parrafos.length - 1, k + 1), { tipo: 'susurro', texto }));
  // Las piezas van antes del párrafo que les toca, para que el texto las rodee.
  return parrafos.flatMap((texto, i) => [...(despues.get(i) ?? []), { tipo: 'parrafo', texto } as EntradaFlujo]);
};
for (const sec of secciones) sec.flujo = flujoDe(sec.parrafos, sec.piezas, sec.susurros);

// Reparte los susurros (menos el primero, que va arriba) entre las piezas.
const susurrosTras = (susurros: string[], j: number, total: number) => {
  const resto = susurros.slice(1);
  const porPieza = Math.max(1, Math.ceil(resto.length / Math.max(1, total)));
  return j === total - 1 ? resto.slice(j * porPieza) : resto.slice(j * porPieza, (j + 1) * porPieza);
};
const seccionReferencias = secciones.find((s) => s.referencias);
---

<LayoutCarta
  vistas={vistas}
  title={`GASTÓN MARTINO // ${pagina.codigo} • ${pagina.titulo}`}
  description={documento.datos.descripcion ?? `${pagina.titulo}. ${pagina.subtitulo}`}
  claseHtml="html-hamatus"
  claseCuerpo="cuerpo-hamatus"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  </Fragment>

  <!-- Barra de menú del sistema falso, con la navegación de la página. -->
  <header class="hm-menu-sistema">
    <nav class="hm-menu-sistema__lado">
      <Volver href={volver} class="hm-boton-sistema">◄ Volver</Volver>
      <BotonAparejo class="hm-boton-sistema hm-boton-sistema--icono" />
      <span class="hm-menu-sistema__item"><u>A</u>rchivo</span>
      <span class="hm-menu-sistema__item"><u>E</u>xcavación</span>
      <span class="hm-menu-sistema__item"><u>V</u>er</span>
      <span class="hm-menu-sistema__item"><u>A</u>yuda</span>
    </nav>
    <p class="hm-menu-sistema__rotulo">
      <span class="hm-punto" style={`background:${pagina.color}`}></span>{pagina.codigo} // {pagina.etiqueta}
    </p>
    <nav class="hm-menu-sistema__lado">
      {mapa && (
        <a href={withBase(mapa.url)} data-alternar-vista="cerrado" data-ir-al-mapa class="hm-boton-sistema">Ver el mapa ►</a>
      )}
      <BotonMenuDerrotero class="hm-boton-sistema hm-boton-sistema--icono" />
    </nav>
  </header>

  <!-- Regla estratigráfica: la profundidad de la excavación según se baja. -->
  <aside class="hm-regla" aria-hidden="true">
    <span class="hm-regla__lectura" data-profundidad>PROF. 0,00 m</span>
  </aside>

  <div class="hm-pagina" data-pagina>
    <div class="hm-lamina" data-lamina>
      <script is:inline>
        // Antes de dibujar: la composición según el ancho del lugar de la
        // página (ancha desde 1360 px, media desde 960, angosta por debajo) y
        // su escala. La angosta es fluida: no se escala.
        (() => {
          const lamina = document.currentScript.parentElement;
          const ancho = lamina.parentElement.clientWidth;
          const composicion = ancho >= 1360 ? 'ancha' : ancho >= 960 ? 'media' : 'angosta';
          document.documentElement.dataset.hmComposicion = composicion;
          lamina.style.zoom = composicion === 'angosta' ? '1'
            : String(Math.min(composicion === 'media' ? 1.3 : 1.35, Math.max(0.6, ancho / (composicion === 'media' ? 880 : 1280))));
        })();
      </script>

      <!-- PORTADA -->
      <section class="hm-portada" id="superficie">
        {/* Dos versiones del mapa: en la composición ancha, sus referencias van más
            chicas. Se muestra una sola (hamatus.css); la otra, oculta y en
            diferido, no se descarga. */}
        <img class="hm-mapa-fondo hm-portada__mapa hm-portada__mapa--ancha" src={mapaLatinoamericaAncha} alt="" aria-hidden="true" loading="lazy" />
        <img class="hm-mapa-fondo hm-portada__mapa hm-portada__mapa--estandar" src={mapaLatinoamerica} alt="" aria-hidden="true" loading="lazy" />
        <p class="hm-etiqueta hm-portada__etiqueta">
          EXPEDIENTE {pagina.codigo} · SUPERFICIE · ESPÉCIMEN TIPO<br />{pagina.subtitulo}
        </p>
        <h1 class="hm-display hm-portada__titulo">
          {palabrasTitulo.map((palabra) => <span class="hm-falla" data-texto={palabra}>{palabra}</span>)}
        </h1>
        {bajada && <p class="hm-susurro hm-portada__bajada">{sinMarcas(bajada).toLowerCase()}</p>}

        {fotoPortada && (() => {
          const trama = tramaDe(fotoPortada.src);
          return (
            <Ventana
              titulo={`${nombreArchivo(fotoPortada.src).replace(/\.\w+$/, '.bmp')} — Visor de especímenes`}
              menu={['Archivo', 'Edición', 'Ver', 'Ayuda']}
              estado={[trama ? '4 colores · tramado ordenado · clic para ampliar' : 'Lámina', 'HH-01 · Hallazgo in situ']}
              class="hm-portada__foto"
            >
              <Foto src={fotoPortada.src} alt={fotoPortada.alt} trama={trama} original={originalDe(fotoPortada.src)} nombre={nombreArchivo(originalDe(fotoPortada.src))} carga="eager" />
            </Ventana>
          );
        })()}

        <div class="hm-escritorio">
          {iconos.map((icono) => (
            <a class="hm-icono-escritorio" href={withBase(icono.href)} target={/^https?:|\.pdf$/i.test(icono.href) ? '_blank' : undefined} rel="noopener" title={icono.texto}>
              <span class="hm-icono-grande hm-icono-grande--documento" aria-hidden="true"></span>
              <span>{nombreArchivo(icono.href)}</span>
            </a>
          ))}
          <a class="hm-icono-escritorio" href="#estrato-1">
            <span class="hm-icono-grande hm-icono-grande--carpeta" aria-hidden="true"></span>
            <span>Estratos</span>
          </a>
          {seccionReferencias && (
            <a class="hm-icono-escritorio" href={`#${seccionReferencias.id}`}>
              <span class="hm-icono-grande hm-icono-grande--texto" aria-hidden="true"></span>
              <span>Referencias.txt</span>
            </a>
          )}
        </div>
      </section>

      <!-- PRÓLOGO: ficha del espécimen, sitios y láminas -->
      {(ficha || palabrasClave || laminasPrologo.length > 0) && (
        <section class="hm-prologo">
          {ficha && (
            <Ventana titulo={`Propiedades de ${ficha.titulo}`} icono="ficha" class="hm-ficha">
              <div class="hm-pestanas" aria-hidden="true">
                <span class="hm-pestanas__activa">General</span><span>Hábitat</span><span>Ganchos</span><span>Seguridad</span>
              </div>
              <div class="hm-ficha__cuerpo">
                <div class="hm-ficha__encabezado">
                  <span class="hm-icono-grande hm-icono-grande--especimen" aria-hidden="true"></span>
                  <div>
                    <p class="hm-ficha__nombre">{ficha.titulo}</p>
                    <p class="hm-ficha__tipo">Tipo: población · Hábitat: redes australes</p>
                  </div>
                </div>
                {ficha.textos.map((texto) => <p class="hm-ficha__texto" set:html={enLinea(texto)} />)}
                {palabrasClave && (
                  <fieldset class="hm-grupo">
                    <legend>{palabrasClave.rotulo}</legend>
                    <ul class="hm-lista-chequeo">
                      {palabrasClave.items.map((item) => <li><span class="hm-chequeo" aria-hidden="true">✓</span>{item}</li>)}
                    </ul>
                  </fieldset>
                )}
                <div class="hm-ficha__botones" aria-hidden="true"><span>Aceptar</span><span>Cancelar</span><span>Aplicar</span></div>
              </div>
            </Ventana>
          )}

          <Ventana titulo="Sitios de hallazgo — cono_sur.map" icono="mapa" estado={['Proyección: Mercator', 'Escala 1:9 000 000']} class="hm-sitios" inactiva>
            <img class="hm-sitios__mapa" src={mapaConoSur} alt="Mapa del Cono Sur con los sitios de hallazgo del Homo hamatus" />
          </Ventana>

          {laminasPrologo.length > 0 && (
            <div class="hm-prologo__laminas">
              {laminasPrologo.map((imagen, i) => (
                <Ventana
                  titulo={`${nombreArchivo(imagen.src)} — Lámina ${String(i + 1).padStart(2, '0')}`}
                  class:list={['hm-prologo__lamina', esVertical(imagen.src) && 'hm-prologo__lamina--vertical']}
                  estado={[imagen.alt]}
                  inactiva={i > 0}
                >
                  <img class="hm-lamina-img" src={withBase(imagen.src)} alt={imagen.alt} loading="lazy" decoding="async" />
                </Ventana>
              ))}
            </div>
          )}
          <p class="hm-susurro hm-prologo__susurro">nadie se sostiene solo</p>
        </section>
      )}

      <!-- ESTRATOS: un capítulo por "##" -->
      {capitulosConTexto.map((sec, i) => (
        <section class:list={['hm-estrato', sec.espejo && 'hm-estrato--espejo']} id={sec.id}>
          <img class="hm-mapa-fondo hm-estrato__mapa" src={sec.mapa} alt="" aria-hidden="true" loading="lazy" />
          {sec.fondos.map((fondo, k) => (
            <img class:list={['hm-lamina-fondo', `hm-lamina-fondo--${k + 1}`]} src={fondo} alt="" aria-hidden="true" loading="lazy" />
          ))}
          <header class="hm-estrato__encabezado">
            <p class="hm-etiqueta">ESTRATO {sec.numero} · PROF. {profundidad(i)} · CAPA DE OCUPACIÓN</p>
            <h2 class="hm-display hm-estrato__titulo"><span class="hm-falla" data-texto={sec.titulo}>{sec.titulo}</span></h2>
          </header>

          <div class="hm-estrato__texto">
            {sec.parrafos.map((texto) => <p set:html={enLinea(texto)} />)}
          </div>

          <!-- Composición media: una sola columna de texto con las piezas
               flotando a un lado, intercaladas entre los párrafos. -->
          <div class="hm-estrato__flujo">
            {sec.flujo.map((entrada) => entrada.tipo === 'parrafo'
              ? <p set:html={enLinea(entrada.texto)} />
              : entrada.tipo === 'susurro'
                ? <p class="hm-susurro hm-susurro--nota">{entrada.texto}</p>
                : <Pieza pieza={entrada.pieza} numero={sec.numero} indice={entrada.indice} class="hm-pieza--flotante" />)}
          </div>

          <div class="hm-estrato__piezas">
            {sec.susurros.length > 0 && <p class="hm-susurro hm-susurro--suelto">{sec.susurros[0]}</p>}
            {sec.piezas.map((pieza, j) => [
              <Pieza pieza={pieza} numero={sec.numero} indice={j} />,
              // Después de cada pieza, los susurros que le tocan (el resto, al final).
              ...susurrosTras(sec.susurros, j, sec.piezas.length).map((susurro) => <p class="hm-susurro hm-susurro--suelto">{susurro}</p>),
            ])}
          </div>
        </section>
      ))}

      <!-- REFERENCIAS: una carpeta en vista de detalles -->
      {seccionReferencias && (
        <section class="hm-referencias" id={seccionReferencias.id}>
          <Ventana titulo={`C:\\HAMATUS\\${seccionReferencias.titulo.toUpperCase()}`} icono="carpeta" menu={['Archivo', 'Edición', 'Ver', 'Herramientas']} estado={[`${seccionReferencias.referencias!.length} objetos`, 'Fuentes del expediente']}>
            <table class="hm-detalles">
              <thead><tr><th>Nombre</th><th>Año</th><th>Título</th></tr></thead>
              <tbody>
                {seccionReferencias.referencias!.map((ref) => (
                  <tr>
                    <td><span class="hm-icono hm-icono--texto" aria-hidden="true"></span>{ref.autor}</td>
                    <td>{ref.anio}</td>
                    <td set:html={enLinea(ref.titulo)} />
                  </tr>
                ))}
              </tbody>
            </table>
          </Ventana>
          <p class="hm-susurro hm-referencias__susurro">el reenganche ya deja de presentarse como una posibilidad</p>
        </section>
      )}
    </div>
  </div>

  <!-- Visor de imágenes: las fotos originales, sin intervenir, a escala real. -->
  <div class="hm-visor" data-visor hidden role="dialog" aria-modal="true" aria-label="Visor de imágenes">
    <div class="hm-visor__fondo" data-visor-cerrar></div>
    <section class="hm-ventana hm-visor__ventana">
      <header class="hm-ventana__barra">
        <span class="hm-icono hm-icono--imagen" aria-hidden="true"></span>
        <span class="hm-ventana__titulo" data-visor-titulo>Visor de imágenes</span>
        <span class="hm-ventana__botones">
          <span aria-hidden="true">_</span><span aria-hidden="true">□</span>
          <button type="button" data-visor-cerrar aria-label="Cerrar el visor">×</button>
        </span>
      </header>
      <nav class="hm-visor__herramientas">
        <button type="button" class="hm-boton-sistema" data-visor-paso="-1">◄ Anterior</button>
        <button type="button" class="hm-boton-sistema" data-visor-paso="1">Siguiente ►</button>
        <span class="hm-visor__separador" aria-hidden="true"></span>
        <button type="button" class="hm-boton-sistema" data-visor-escala aria-pressed="false">Tamaño real</button>
        <span class="hm-visor__contador" data-visor-contador></span>
      </nav>
      <div class="hm-ventana__cuerpo hm-visor__lienzo" data-visor-lienzo>
        <img data-visor-img alt="" />
      </div>
      <div class="hm-visor__tira" data-visor-tira></div>
      <footer class="hm-ventana__estado">
        <span data-visor-alt></span>
        <span data-visor-medidas></span>
      </footer>
    </section>
  </div>

  <!-- Barra de tareas: los estratos y el reloj. -->
  <footer class="hm-tareas">
    <a class="hm-tareas__inicio" href="#superficie"><span class="hm-icono hm-icono--especimen" aria-hidden="true"></span>Inicio</a>
    <nav class="hm-tareas__lista">
      {secciones.map((sec) => (
        <a href={`#${sec.id}`} data-tarea={sec.id}><span class={`hm-icono hm-icono--${sec.referencias ? 'carpeta' : 'texto'}`} aria-hidden="true"></span>{sec.referencias ? <span class="hm-tareas__nombre">{sec.titulo}</span> : <Fragment>{sec.numero}.<span class="hm-tareas__nombre"> {sec.titulo}</span></Fragment>}</a>
      ))}
    </nav>
    <span class="hm-tareas__reloj" data-reloj>--:--</span>
  </footer>
</LayoutCarta>

<script>
  // Composición y escala de la lámina según el ancho del lugar de la página:
  // ancha (compuesta a 1280 px) desde 1360 px; media (a 880 px) desde 960 px;
  // angosta (fluida, sin escalar) por debajo. La primera vez lo decide el
  // script en línea de la lámina, antes de dibujar.
  const ANCHO_COMPOSICION_ANCHA = 1360;
  const ANCHO_COMPOSICION_MEDIA = 960;
  const pagina = document.querySelector<HTMLElement>('[data-pagina]');
  const lamina = document.querySelector<HTMLElement>('[data-lamina]');
  let zoom = 1;
  const ajustar = () => {
    if (!pagina || !lamina) return;
    const ancho = pagina.clientWidth;
    const composicion = ancho >= ANCHO_COMPOSICION_ANCHA ? 'ancha' : ancho >= ANCHO_COMPOSICION_MEDIA ? 'media' : 'angosta';
    document.documentElement.dataset.hmComposicion = composicion;
    zoom = composicion === 'angosta' ? 1
      : Math.min(composicion === 'media' ? 1.3 : 1.35, Math.max(0.6, ancho / (composicion === 'media' ? 880 : 1280)));
    lamina.style.setProperty('zoom', String(zoom));
  };
  ajustar();
  if (pagina) new ResizeObserver(ajustar).observe(pagina);

  // Ventanas arrastrables por su barra de título; la última tocada queda arriba.
  let capa = 10;
  document.querySelectorAll<HTMLElement>('[data-ventana]').forEach((ventana) => {
    const barra = ventana.querySelector<HTMLElement>('[data-arrastre]');
    let x = 0, y = 0, inicio: { x: number; y: number } | null = null;
    const activar = () => {
      document.querySelectorAll('[data-ventana]').forEach((v) => v.classList.add('hm-ventana--inactiva'));
      ventana.classList.remove('hm-ventana--inactiva');
      ventana.style.zIndex = String(++capa);
    };
    ventana.addEventListener('pointerdown', activar);
    barra?.addEventListener('pointerdown', (e) => {
      inicio = { x: e.clientX - x * zoom, y: e.clientY - y * zoom };
      barra.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    barra?.addEventListener('pointermove', (e) => {
      if (!inicio) return;
      x = (e.clientX - inicio.x) / zoom;
      y = (e.clientY - inicio.y) / zoom;
      ventana.style.translate = `${x}px ${y}px`;
    });
    const soltar = () => { inicio = null; };
    barra?.addEventListener('pointerup', soltar);
    barra?.addEventListener('pointercancel', soltar);
  });

  // Regla estratigráfica y botón activo de la barra de tareas.
  const lectura = document.querySelector<HTMLElement>('[data-profundidad]');
  const tareas = document.querySelectorAll<HTMLAnchorElement>('[data-tarea]');
  const estratos = [...document.querySelectorAll<HTMLElement>('.hm-estrato, .hm-referencias')];
  const alBajar = () => {
    const metros = (window.scrollY / 400).toFixed(2).replace('.', ',');
    if (lectura) lectura.textContent = `PROF. −${metros} m`;
    const actual = estratos.filter((s) => s.getBoundingClientRect().top < window.innerHeight * 0.4).pop();
    tareas.forEach((t) => t.classList.toggle('hm-activa', t.dataset.tarea === actual?.id));
  };
  window.addEventListener('scroll', alBajar, { passive: true });
  alBajar();

  // Visor: clic (o Enter) en una foto la abre, original y sin intervenir.
  const visor = document.querySelector<HTMLElement>('[data-visor]');
  const visorImg = visor?.querySelector<HTMLImageElement>('[data-visor-img]');
  const visorLienzo = visor?.querySelector<HTMLElement>('[data-visor-lienzo]');
  const visorTira = visor?.querySelector<HTMLElement>('[data-visor-tira]');
  const botonEscala = visor?.querySelector<HTMLButtonElement>('[data-visor-escala]');
  // Una entrada por foto (la misma foto puede aparecer más de una vez).
  const fotos = [...new Map([...document.querySelectorAll<HTMLElement>('[data-foto]')]
    .map((f) => [f.dataset.original!, f])).values()];
  let actual = 0;
  let volverA: HTMLElement | null = null;

  fotos.forEach((foto, i) => {
    const miniatura = document.createElement('button');
    miniatura.type = 'button';
    miniatura.className = 'hm-visor__miniatura';
    miniatura.setAttribute('aria-label', foto.dataset.alt ?? '');
    miniatura.innerHTML = `<img src="${foto.dataset.miniatura}" alt="" loading="lazy">`;
    miniatura.addEventListener('click', () => mostrar(i));
    visorTira?.append(miniatura);
  });

  const escalaReal = (real: boolean) => {
    visorLienzo?.classList.toggle('hm-visor__lienzo--real', real);
    botonEscala?.setAttribute('aria-pressed', String(real));
    if (botonEscala) botonEscala.textContent = real ? 'Ajustar a la ventana' : 'Tamaño real';
  };

  const mostrar = (i: number) => {
    if (!visor || !visorImg) return;
    actual = (i + fotos.length) % fotos.length;
    const foto = fotos[actual];
    escalaReal(false);
    visorImg.src = foto.dataset.original!;
    visorImg.alt = foto.dataset.alt ?? '';
    visor.querySelector('[data-visor-titulo]')!.textContent = `${foto.dataset.nombre} — Visor de imágenes`;
    visor.querySelector('[data-visor-alt]')!.textContent = foto.dataset.alt ?? '';
    visor.querySelector('[data-visor-contador]')!.textContent = `${actual + 1} de ${fotos.length}`;
    visor.querySelector('[data-visor-medidas]')!.textContent = 'Cargando…';
    visorTira?.querySelectorAll('button').forEach((b, k) => b.classList.toggle('hm-activa', k === actual));
    visorTira?.children[actual]?.scrollIntoView({ block: 'nearest', inline: 'center' });
  };

  visorImg?.addEventListener('load', () => {
    visor!.querySelector('[data-visor-medidas]')!.textContent = `${visorImg.naturalWidth} × ${visorImg.naturalHeight} px · original`;
  });

  const abrir = (i: number) => {
    if (!visor) return;
    volverA = document.activeElement as HTMLElement;
    visor.hidden = false;
    document.documentElement.classList.add('hm-con-visor');
    mostrar(i);
    visor.querySelector<HTMLButtonElement>('button[data-visor-cerrar]')?.focus();
  };

  const cerrar = () => {
    if (!visor || visor.hidden) return;
    visor.hidden = true;
    document.documentElement.classList.remove('hm-con-visor');
    visorImg?.removeAttribute('src');
    volverA?.focus();
  };

  document.querySelectorAll<HTMLElement>('[data-foto]').forEach((foto) => {
    const i = fotos.findIndex((f) => f.dataset.original === foto.dataset.original);
    foto.addEventListener('click', () => abrir(i));
    foto.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(i); }
    });
  });
  visor?.querySelectorAll('[data-visor-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
  visor?.querySelectorAll<HTMLElement>('[data-visor-paso]').forEach((b) =>
    b.addEventListener('click', () => mostrar(actual + Number(b.dataset.visorPaso))));
  botonEscala?.addEventListener('click', () => escalaReal(!visorLienzo?.classList.contains('hm-visor__lienzo--real')));
  visorImg?.addEventListener('click', () => escalaReal(!visorLienzo?.classList.contains('hm-visor__lienzo--real')));
  document.addEventListener('keydown', (e) => {
    if (!visor || visor.hidden) return;
    if (e.key === 'Escape') cerrar();
    else if (e.key === 'ArrowRight') mostrar(actual + 1);
    else if (e.key === 'ArrowLeft') mostrar(actual - 1);
    else return;
    e.preventDefault();
    e.stopPropagation();
  }, true);

  // Reloj de la barra de tareas.
  const reloj = document.querySelector<HTMLElement>('[data-reloj]');
  const hora = () => { if (reloj) reloj.textContent = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }); };
  hora();
  setInterval(hora, 20000);
</script>
