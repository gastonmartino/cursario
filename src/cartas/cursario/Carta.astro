---
// CURSARIO
// Carta experimental con forma de carta náutica: marco graduado, sondeos,
// curvas de profundidad, rosas de los vientos y recuadros negros escalonados,
// con el contenido del Markdown repartido sobre la hoja. Tiene una composición
// por rango de ancho de ventana (ver composicion.ts); el contenido se escribe una
// sola vez, con su lugar en cada una, y el CSS elige cuál usar.
import LayoutCarta from '../../layouts/LayoutCarta.astro';
import Volver from '../../components/navegacion/Volver.astro';
import BotonMenu from '../../components/navegacion/BotonMenu.astro';
import { renderizarEnLinea, type BloqueMimo } from '../../utils/markdown';
import { withBase } from '../../utils/paths';
import type { PropsCarta } from '../index';
import { COMPOSICIONES, type Composicion, type NombreComposicion } from './composicion';
import { generarGrafica, PALETA } from './grafica';

type Props = PropsCarta;

const { pagina, documento, volver, vistas } = Astro.props;

// --- Reparto del contenido ---
// Antes del primer "##": título, imágenes y notas. Cada "##" se escribe sobre
// una rosa, y los ítems de sus listas (o sus párrafos) son topónimos. Lo que
// sigue a un separador, después de alguna sección, va al cartucho.
type Imagen = Extract<BloqueMimo, { tipo: 'imagen' }>;
const titulo = documento.bloques.find((b) => b.tipo === 'titulo' && b.nivel === 1);
const imagenes: Imagen[] = [];
const notas: string[] = [];
const encabezados: string[] = [];
const toponimos: Array<{ termino: string; texto: string }> = [];
const colofon: string[] = [];

const comoToponimo = (texto: string) => {
  const conTermino = texto.match(/^\*\*(.+?)\*\*\s*(.*)$/);
  return conTermino ? { termino: conTermino[1], texto: conTermino[2] } : { termino: '', texto };
};

let enSecciones = false;
let enColofon = false;
for (const bloque of documento.bloques) {
  if (bloque.tipo === 'imagen') imagenes.push(bloque);
  else if (bloque.tipo === 'titulo' && bloque.nivel === 2) { encabezados.push(bloque.texto); enSecciones = true; enColofon = false; }
  else if (bloque.tipo === 'separador' && enSecciones) enColofon = true;
  else if (bloque.tipo === 'lista') toponimos.push(...bloque.items.map(comoToponimo));
  else if (bloque.tipo === 'parrafo') {
    if (enColofon) colofon.push(bloque.texto);
    else if (enSecciones) toponimos.push(comoToponimo(bloque.texto));
    else notas.push(bloque.texto);
  }
}

const VARIANTES = Object.entries(COMPOSICIONES) as Array<[NombreComposicion, Composicion]>;

// Un lugar reservado para cada elemento; los que sobran, más abajo.
const lugar = <T extends { y: number }>(lugares: T[], i: number, salto: number): T => {
  const base = lugares[i % lugares.length];
  return { ...base, y: base.y + Math.floor(i / lugares.length) * salto };
};

// Clases para mostrar un elemento solo en algunas composiciones.
const ocultoFuera = (nombres: NombreComposicion[]) =>
  VARIANTES.filter(([nombre]) => !nombres.includes(nombre)).map(([nombre]) => `oculto-${nombre}`);

// Clase y estilo de un elemento con un lugar en cada composición: su posición va
// en variables (--x-xl, --y-xl, --a-xl, --h-xl…) que el CSS usa
// según el ancho de la ventana. Donde no tiene lugar, no se muestra.
type Posicion = { x: number; y: number; ancho: number; alto?: number } | null | undefined;
const ubicado = (posicion: (composicion: Composicion, nombre: NombreComposicion) => Posicion, ...clases: string[]) => {
  const estilo: string[] = [];
  const con: NombreComposicion[] = [];
  for (const [nombre, composicion] of VARIANTES) {
    const p = posicion(composicion, nombre);
    if (!p) continue;
    con.push(nombre);
    estilo.push(`--x-${nombre}: ${p.x}px`, `--y-${nombre}: ${p.y}px`, `--a-${nombre}: ${p.ancho}px`);
    if (p.alto !== undefined) estilo.push(`--h-${nombre}: ${p.alto}px`);
  }
  return { class: ['ubicado', ...clases, ...ocultoFuera(con)].filter(Boolean).join(' '), style: estilo.join('; ') };
};

// El modo de una lámina (recuadro, papel, transparencia) es el mismo en todas
// las composiciones donde aparece.
const modoImagen = (i: number) => {
  const modos = new Set(VARIANTES.map(([, c]) => c.imagenes[i]?.modo).filter(Boolean));
  if (modos.size > 1) throw new Error(`La imagen ${i + 1} de la carta "cursario" tiene distintos modos según la composición.`);
  return [...modos][0] ?? 'recuadro';
};

// Medidas de la hoja y de la navegación en cada composición.
const estiloHoja = VARIANTES.flatMap(([nombre, { hoja, navegacion }]) => [
  `--ancho-${nombre}: ${hoja.ancho}px`, `--alto-${nombre}: ${hoja.alto}px`,
  `--nav-arriba-${nombre}: ${navegacion.arriba}px`, `--nav-izquierda-${nombre}: ${navegacion.izquierda}px`,
  `--nav-derecha-${nombre}: ${navegacion.derecha}px`, `--nav-posicion-${nombre}: ${navegacion.fija ? 'fixed' : 'absolute'}`,
]).join('; ');

const enLinea = (texto: string) => renderizarEnLinea(texto);
// Texto sin marcas de Markdown, para los rótulos curvos del SVG.
const textoPlano = (texto: string) => texto.replace(/[*_`]/g, '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
const px = (valor: number) => `${valor}px`;
const rect = ([x, y, ancho, alto]: number[]) => ({ x, y, ancho, alto });

// Miniatura de los recuadros para el índice del cartucho.
const indice = ({ hoja, recuadros }: Composicion) => {
  const escala = 70 / hoja.alto;
  return {
    ancho: hoja.ancho * escala,
    rectangulos: recuadros.flat().map(([x, y, a, h]) => ({ x: x * escala, y: y * escala, a: a * escala, h: h * escala })),
  };
};

const romanos = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
---

<LayoutCarta
  vistas={vistas}
  title={`${pagina.codigo} · ${titulo ? titulo.texto : pagina.titulo} — Cursario`}
  description={documento.datos.descripcion}
  claseHtml="html-cursario"
  claseCuerpo="cuerpo-cursario"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;600;700&family=Tinos:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  </Fragment>

  <div class="hoja" style={estiloHoja}>
    {/* Gráfica de cada composición, con los encabezados "##" escritos alrededor de las rosas */}
    {VARIANTES.map(([nombre, composicion]) => (
      <div class:list={['grafica', ...ocultoFuera([nombre])]}>
        <Fragment set:html={generarGrafica(composicion, nombre)} />
        <svg class="rotulos-curvos" viewBox={`0 0 ${composicion.hoja.ancho} ${composicion.hoja.alto}`} width={composicion.hoja.ancho} height={composicion.hoja.alto} aria-hidden="true">
          <defs>
            {composicion.rosas.map(({ x, y, r }, i) => (
              <path id={`curva-${nombre}-${i}`} d={`M${x - r - 30},${y} a${r + 30},${r + 30} 0 1,1 ${2 * (r + 30)},0 a${r + 30},${r + 30} 0 1,1 ${-2 * (r + 30)},0`} />
            ))}
          </defs>
          {encabezados.map((texto, i) => (
            <text class="rotulo-curvo"><textPath href={`#curva-${nombre}-${(i + 1) % composicion.rosas.length}`} startOffset="2%">{textoPlano(texto).toUpperCase()}</textPath></text>
          ))}
          <text class="rotulo-curvo rotulo-curvo--fino"><textPath href={`#curva-${nombre}-0`} startOffset="54%">{pagina.etiqueta}</textPath></text>
        </svg>
        {/* Rótulos sueltos, como "PROFUNDIDADES EN METROS" */}
        {composicion.rotulos.map(({ arriba, izquierda, derecha }) => (
          <p class="rotulo-borde" style={[`top: ${px(arriba)}`, izquierda !== undefined && `left: ${px(izquierda)}`, derecha !== undefined && `right: ${px(derecha)}`].filter(Boolean).join('; ')}>Profundidades en derivas</p>
        ))}
      </div>
    ))}

    {/* Título */}
    <header {...ubicado((c) => rect(c.titulo), 'titulo')}>
      <p class="titulo__antetitulo">{pagina.codigo}</p>
      <p class="titulo__antetitulo titulo__antetitulo--chico">Carta de derivas · CUR&nbsp;001</p>
      {titulo && <h1 set:html={enLinea(titulo.texto)} />}
      <p class="titulo__subtitulo">{pagina.etiqueta}</p>
    </header>

    {/* Navegación */}
    <Volver href={volver} class="nav nav--volver">← VOLVER</Volver>
    <BotonMenu class="nav nav--menu" />

    {/* Imágenes */}
    {imagenes.map((imagen, i) => (
      <figure {...ubicado((c) => c.imagenes[i], 'lamina', `lamina--${modoImagen(i)}`)}>
        <img src={withBase(imagen.src)} alt={imagen.alt} loading="lazy" decoding="async" />
        <figcaption>{imagen.pie ?? `Lámina ${romanos[i] ?? i + 1}`}</figcaption>
      </figure>
    ))}

    {/* Notas */}
    {notas.map((texto, i) => {
      const enRecuadro = VARIANTES.some(([, c]) => lugar(c.notas, i, 700).enRecuadro);
      return (
        <div {...ubicado((c) => lugar(c.notas, i, 700), 'nota', enRecuadro ? 'nota--recuadro' : '')}>
          <p class="nota__numero">Nota {romanos[i] ?? i + 1}</p>
          <p set:html={enLinea(texto)} />
        </div>
      );
    })}

    {/* Topónimos */}
    {toponimos.map(({ termino, texto }, i) => (
      <div {...ubicado((c) => lugar(c.toponimos, i, 700), 'toponimo')}>
        {termino && <p class="toponimo__nombre" set:html={enLinea(termino)} />}
        <p class="toponimo__texto" set:html={enLinea(texto)} />
      </div>
    ))}

    {/* Cartucho de la leyenda */}
    <aside {...ubicado((c) => rect(c.cartucho), 'cartucho')}>
      <div class="cartucho__fila cartucho__fila--doble">
        <span>{pagina.codigo}</span><span>{pagina.etiqueta}</span>
      </div>
      <div class="cartucho__cuerpo">
        {VARIANTES.map(([nombre, composicion]) => {
          const { ancho, rectangulos } = indice(composicion);
          return (
            <svg class:list={['cartucho__indice', ...ocultoFuera([nombre])]} viewBox={`0 0 ${ancho} 70`} width={ancho} height="70" aria-hidden="true">
              <rect x="0.5" y="0.5" width={ancho - 1} height="69" fill="none" stroke={PALETA.tinta} stroke-width="0.6" />
              {rectangulos.map(({ x, y, a, h }) => <rect x={x} y={y} width={a} height={h} fill="none" stroke={PALETA.bermellon} stroke-width="0.6" />)}
            </svg>
          );
        })}
        <div class="cartucho__texto">
          {colofon.map((texto) => <p set:html={enLinea(texto)} />)}
        </div>
      </div>
      <div class="cartucho__fila"><span>Escala 1 : ∞</span><span>Proyección Mercator de las derivas</span></div>
      <div class="cartucho__fila"><span>CUR 001</span><span>Edición {new Date().getFullYear()}</span></div>
    </aside>
  </div>
</LayoutCarta>

<style is:global>
  /* Los estilos globales del bundle llegan a todas las páginas de cartas: cada
     regla va bajo la clase de la carta en <html> o <body>. */
  html.html-cursario {
    --papel: #efe9dc;
    --papel-oscuro: #e3dccd;
    --tinta: #141416;
    --ultramar: #1f3797;
    --bermellon: #e2472b;
    --ocre: #c8934a;
    --serif: Tinos, 'Times New Roman', serif;
    --condensada: 'Archivo Narrow', 'Arial Narrow', sans-serif;
  }

  body.cuerpo-cursario {
    margin: 0;
    overflow-x: clip;
    background: var(--papel-oscuro);
    color: var(--tinta);
    font-family: var(--serif);
    -webkit-font-smoothing: antialiased;
  }

  html.html-cursario #page-transition {
    background: var(--papel-oscuro);
  }

  html.html-cursario ::selection {
    background: var(--bermellon);
    color: var(--papel);
  }

  /* Composición lg: el papel es el fondo de la página. */
  @media (max-width: 1279.98px) {
    body.cuerpo-cursario,
    html.html-cursario #page-transition {
      background: var(--papel);
    }
  }
</style>

<style>
  /* Composiciones. Cada una se usa en un rango de ancho de ventana:
       xl: desde 1280 px
       lg: de 930 a 1279 px
       md: de 620 a 929 px
       sm: hasta 619 px (pensada para llegar hasta 420 px)
     Los elementos con lugar en la hoja (.ubicado) toman su posición de las
     variables de la composición que corresponde; los que no tienen lugar en
     ella llevan la clase oculto-{composición}. */

  /* La hoja, siempre centrada respecto del ancho total de la ventana (100vw
     incluye la barra de desplazamiento). En ventanas más angostas que la hoja,
     el margen izquierdo se vuelve negativo y la hoja se recorta igual de los dos
     lados: a la izquierda en el borde de la ventana, a la derecha bajo la barra. */
  .hoja {
    position: relative;
    width: var(--ancho-xl);
    height: var(--alto-xl);
    margin: 32px 0 64px calc(50vw - var(--ancho-xl) / 2);
    background: var(--papel);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08), 0 18px 40px -24px rgba(20, 20, 22, 0.45);
    overflow: hidden;
  }

  .ubicado {
    position: absolute;
    left: var(--x-xl);
    top: var(--y-xl);
    width: var(--a-xl);
  }

  .lamina img,
  .cartucho {
    height: var(--h-xl);
  }

  :global(.nav) {
    position: var(--nav-posicion-xl);
    top: var(--nav-arriba-xl);
  }

  :global(.nav--volver) {
    left: var(--nav-izquierda-xl);
  }

  :global(.nav--menu) {
    right: var(--nav-derecha-xl);
  }

  @media (min-width: 1280px) {
    .oculto-xl {
      display: none !important;
    }
  }

  @media (min-width: 930px) and (max-width: 1279.98px) {
    .hoja {
      width: var(--ancho-lg);
      height: var(--alto-lg);
      margin: 0 0 0 calc(50vw - var(--ancho-lg) / 2);
      box-shadow: none;
    }

    .ubicado {
      left: var(--x-lg);
      top: var(--y-lg);
      width: var(--a-lg);
    }

    .lamina img,
    .cartucho {
      height: var(--h-lg);
    }

    :global(.nav) {
      position: var(--nav-posicion-lg);
      top: var(--nav-arriba-lg);
    }

    :global(.nav--volver) {
      left: var(--nav-izquierda-lg);
    }

    :global(.nav--menu) {
      right: var(--nav-derecha-lg);
    }

    .hoja .titulo h1 {
      font-size: 34px;
    }

    .oculto-lg {
      display: none !important;
    }
  }
  @media (min-width: 620px) and (max-width: 929.98px) {
    .hoja {
      width: var(--ancho-md);
      height: var(--alto-md);
      margin: 0 0 0 calc(50vw - var(--ancho-md) / 2);
      box-shadow: none;
    }

    .ubicado {
      left: var(--x-md);
      top: var(--y-md);
      width: var(--a-md);
    }

    .lamina img,
    .cartucho {
      height: var(--h-md);
    }

    :global(.nav) {
      position: var(--nav-posicion-md);
      top: var(--nav-arriba-md);
    }

    :global(.nav--volver) {
      left: var(--nav-izquierda-md);
    }

    :global(.nav--menu) {
      right: var(--nav-derecha-md);
    }

    .hoja .titulo h1 {
      font-size: 28px;
    }

    .oculto-md {
      display: none !important;
    }
  }
  @media (max-width: 619.98px) {
    .hoja {
      width: var(--ancho-sm);
      height: var(--alto-sm);
      margin: 0 0 0 calc(50vw - var(--ancho-sm) / 2);
      box-shadow: none;
    }

    .ubicado {
      left: var(--x-sm);
      top: var(--y-sm);
      width: var(--a-sm);
    }

    .lamina img,
    .cartucho {
      height: var(--h-sm);
    }

    :global(.nav) {
      position: var(--nav-posicion-sm);
      top: var(--nav-arriba-sm);
    }

    :global(.nav--volver) {
      left: var(--nav-izquierda-sm);
    }

    :global(.nav--menu) {
      right: var(--nav-derecha-sm);
    }

    .hoja .titulo h1 {
      font-size: 24px;
    }

    .oculto-sm {
      display: none !important;
    }
  }

  .grafica,
  .rotulos-curvos {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .rotulo-curvo {
    fill: var(--bermellon);
    font-family: var(--serif);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.32em;
  }

  .rotulo-curvo--fino {
    font-family: var(--condensada);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.4em;
  }

  /* Título */
  .titulo {
    text-align: center;
  }

  .titulo__antetitulo {
    margin: 0;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .titulo__antetitulo--chico {
    font-weight: 400;
    font-size: 8px;
    letter-spacing: 0.3em;
  }

  .titulo h1 {
    margin: 10px 0 6px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .titulo__subtitulo {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  /* Navegación */
  :global(.nav) {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--tinta);
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--condensada);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-decoration: none;
    cursor: pointer;
  }

  :global(.nav:hover) {
    background: var(--tinta);
    color: var(--papel);
  }

  :global(.nav--volver) {
    padding: 6px 10px;
  }

  :global(.nav--menu) {
    width: 32px;
    height: 32px;
    padding: 0;
  }

  .rotulo-borde {
    position: absolute;
    margin: 0;
    padding: 2px 6px;
    border: 1px solid var(--bermellon);
    color: var(--bermellon);
    font-family: var(--condensada);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* Láminas */
  .lamina {
    margin: 0;
  }

  .lamina img {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  .lamina figcaption {
    margin-top: 4px;
    font-family: var(--condensada);
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .lamina--recuadro figcaption {
    color: var(--papel);
  }

  .lamina--papel {
    padding: 6px;
    border: 1px solid var(--tinta);
    background: var(--papel);
    transform: rotate(-1.6deg);
  }

  .lamina--papel figcaption {
    color: var(--bermellon);
  }

  /* Al recortar la imagen se conserva su parte de arriba (en las curvas de
     relieve, la frase "el agua también se desvía"). */
  .lamina--transparencia img {
    object-position: top;
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  .lamina--transparencia figcaption {
    color: var(--ultramar);
  }

  /* Notas */
  .nota {
    font-family: var(--serif);
    font-size: 12.5px;
    line-height: 1.5;
    text-align: justify;
    hyphens: auto;
  }

  .nota p {
    margin: 0;
  }

  .nota__numero {
    margin-bottom: 6px !important;
    font-family: var(--condensada);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bermellon);
  }

  .nota--recuadro {
    color: var(--papel);
  }

  /* Topónimos */
  .toponimo p {
    margin: 0;
  }

  .toponimo__nombre {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .toponimo__nombre :global(strong) {
    font-weight: 700;
  }

  .toponimo__texto {
    margin-top: 4px !important;
    font-family: var(--serif);
    font-style: italic;
    font-size: 11.5px;
    line-height: 1.35;
  }

  /* Cartucho */
  .cartucho {
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--tinta);
    background: var(--papel);
    font-family: var(--condensada);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cartucho__fila {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 8px;
    border-top: 1px solid var(--tinta);
  }

  .cartucho__fila--doble {
    border-top: none;
    border-bottom: 1px solid var(--tinta);
    font-weight: 700;
    color: var(--bermellon);
  }

